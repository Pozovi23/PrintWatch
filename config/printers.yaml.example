# Конфигурация парка 3D-принтеров

# Общие настройки сбора телеметрии
settings:
  poll_interval: 15.0 # Интервал опроса всех принтеров в секундах

# Список принтеров
printers:
  # Принтер №1
  - name: "printer-1"
    host: "http://192.168.0.xxx"

  # Принтер №2
  - name: "printer-2"
    host: "http://192.168.0.xxx"

  # Принтер №3 (Пример добавления следующего принтера из N)
  # - name: "printer-3"
  #   host: "http://192.168.0.xxx"